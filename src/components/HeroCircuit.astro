---
/**
 * Header circuito JN — Figma: desktop 55:429 (frame 1:2), mobile 103:310 (frame 103:302).
 *
 * Integración del artefacto docs/Header circuito JN — Jorge Nehmer.html sin cambiar
 * su comportamiento (regla del CLAUDE.md). Cambios hechos solo para integrarlo:
 * - Se quitó el <link> a Google Fonts: la fuente la carga Astro (--font-sans).
 * - Se quitó la regla `html, body { background }`: el resto de la página es blanco.
 * - --hero-bg y --font apuntan a los tokens del sitio (mismos valores).
 * - `.hero__art canvas` pasa a :global() porque los canvas los crea el script.
 * - El script vive en src/scripts/hero-circuit.js, idéntico al original.
 * - Hasta 860 px, padding de 80 px arriba y 20 px a los lados, para el navbar fijo.
 * Todo lo demás (medidas, media query de 860 px, animaciones) es el CSS original.
 */
---

<header class="hero" id="hero">
  <div class="hero__copy">
    <h1 class="hero__title">Hola, soy Jorge</h1>
    <p class="hero__lead">Product designer en Santiago, con 5 años creando productos digitales de punta a punta: apps, plataformas web, design systems y marca. Me dedico a hacer simple lo complejo.</p>
    <a class="hero__cta" href="#contacto">Contáctame</a>
  </div>
  <div class="hero__art" id="heroArt" aria-hidden="true"></div>
</header>

<style>
  .hero {
    --hero-bg: var(--hero-bg-from);
    --font: var(--font-sans);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    /* degradado radial del Figma (Rectangle 465), se estira con el header */
    background: var(--hero-bg) url("data:image/svg+xml,%3Csvg viewBox='0 0 1440 761' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='none'%3E%3Crect width='100%25' height='100%25' fill='url(%23g)'/%3E%3Cdefs%3E%3CradialGradient id='g' gradientUnits='userSpaceOnUse' cx='0' cy='0' r='10' gradientTransform='matrix(55.7 58.6 -109.48 86.694 391 158)'%3E%3Cstop stop-color='%230014BC' offset='0'/%3E%3Cstop stop-color='%23000956' offset='1'/%3E%3C/radialGradient%3E%3C/defs%3E%3C/svg%3E") center / 100% 100% no-repeat;
    color: #fff;
    font-family: var(--font);
    height: clamp(480px, 52.85vw, 761px);          /* 761px a 1440 */
  }
  .hero__copy {
    position: absolute;
    z-index: 2;
    top: 55.58%;
    left: max(clamp(24px, 4.375vw, 63px), calc((100% - 1440px) / 2 + 63px));
    width: clamp(260px, 27.9vw, 402px);
    transform: translateY(-50%);
  }
  .hero__title {
    margin: 0 0 14px;
    font-weight: 700;
    font-size: clamp(34px, 3.89vw, 56px);
    line-height: 1.107;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .hero__lead {
    margin: 0 0 14px;
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.61;
    color: rgba(255, 255, 255, 0.55);
    text-wrap: pretty;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 166px;
    padding: 10px 24px;
    border-radius: 8px;
    font: 400 16px/26px var(--font);
    color: #fff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.28),
      inset -1px -1px 0 rgba(255, 255, 255, 0.14);
    transition: background-color .25s ease, transform .25s ease;
  }
  .hero__cta:hover { background: rgba(255, 255, 255, 0.18); transform: translateY(-1px); }
  .hero__cta:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* Arte: caja de 728 × 480 dentro del frame de 1440 × 761 */
  .hero__art {
    position: absolute;
    z-index: 1;
    right: max(min(3.403vw, 49px), calc((100% - 1440px) / 2 + 49px));
    top: 52.3%;
    width: min(728px, 50.556vw);
    aspect-ratio: 728 / 480;
    transform: translateY(-50%);
    touch-action: manipulation;
  }
  .hero__art :global(canvas) { display: block; width: 100%; height: 100%; }

  /* Entrada del texto */
  .hero__copy > * { opacity: 0; transform: translateY(14px); animation: rise .8s cubic-bezier(.2,.7,.2,1) forwards; }
  .hero__copy > :nth-child(2) { animation-delay: .12s; }
  .hero__copy > :nth-child(3) { animation-delay: .24s; }
  @keyframes rise { to { opacity: 1; transform: none; } }

  @media (max-width: 860px) {
    /* Integración con el navbar fijo (Figma 348:1596): el texto empieza en 80 px,
       bajo la cápsula, y a 20 px del borde, alineado con el logotipo. */
    .hero { height: auto; padding: 80px 0 48px; }
    .hero__copy { position: static; transform: none; width: auto; max-width: 460px; padding: 0 20px; }
    .hero__art { position: relative; top: auto; right: auto; transform: none; width: min(96%, 560px); margin: 24px auto 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__copy > * { animation: none; opacity: 1; transform: none; }
    .hero__cta { transition: none; }
  }
</style>

<script>
  import '../scripts/hero-circuit.js';
</script>
