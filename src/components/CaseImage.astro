---
/**
 * Imagen de los casos: <picture> con AVIF y WebP generados por Astro
 * (mismo patrón que ProjectCard). El PNG de origen está exportado en ×2.
 * La proporción la fija el contenedor con `ratio` (ancho / alto de Figma).
 */
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Atributo sizes; por defecto, el ancho de la columna del caso. */
  sizes?: string;
  /** Proporción del placeholder en Figma, p. ej. "800 / 450". */
  ratio?: string;
  eager?: boolean;
  class?: string;
  /** Imagen para mobile cuando cambia la proporción (p. ej. la tabla de TCG). */
  mobile?: ImageMetadata;
  /** Aparece al hacer scroll (documento de traspaso → Animaciones). */
  reveal?: boolean;
  /** Nombre para la transición entre páginas: el mismo que el transition:name de la card del home.
      Va en el style porque transition:name sin valor le pone un nombre a cada imagen. */
  transitionName?: string;
}

const {
  src,
  alt,
  sizes = '(min-width: 1440px) 800px, (min-width: 1024px) calc(100vw - 640px), calc(100vw - 40px)',
  ratio = `${src.width} / ${src.height}`,
  eager = false,
  class: className,
  mobile,
  reveal = false,
  transitionName,
} = Astro.props;

const candidateWidths = [160, 320, 400, 640, 800, 1120, 1440, 1600, 2240, 2880];
const widths = candidateWidths.filter((w) => w < src.width).concat(src.width);

const sources = await Promise.all(
  (['avif', 'webp'] as const).map(async (format) => {
    const out = await getImage({ src, format, widths });
    return { type: `image/${format}`, srcset: out.srcSet.attribute };
  }),
);
const fallback = await getImage({ src, format: 'webp', width: Math.min(1600, src.width) });

/* Versión mobile (< 768 px) para imágenes que cambian de proporción
   (documento de traspaso → Imágenes: nombre-mobile.png). */
const mobileSources = mobile
  ? await Promise.all(
      (['avif', 'webp'] as const).map(async (format) => {
        const w = candidateWidths.filter((x) => x < mobile.width).concat(mobile.width);
        const out = await getImage({ src: mobile, format, widths: w });
        return { type: `image/${format}`, srcset: out.srcSet.attribute };
      }),
    )
  : [];
const mobileRatio = mobile ? `${mobile.width} / ${mobile.height}` : ratio;
---

<div
  class:list={['case-image', { 'case-image--transicion': transitionName }, className]}
  style={`--ratio: ${ratio}; --ratio-mobile: ${mobileRatio}${transitionName ? `; view-transition-name: ${transitionName}` : ''}`}
  data-reveal={reveal || undefined}
>
  <picture>
    {
      mobileSources.map((s) => (
        <source media="(max-width: 767px)" type={s.type} srcset={s.srcset} sizes="calc(100vw - 40px)" />
      ))
    }
    {sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizes} />)}
    <img
      src={fallback.src}
      width={src.width}
      height={src.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  </picture>
</div>

<style>
  .case-image {
    overflow: hidden;
    aspect-ratio: var(--ratio-mobile, var(--ratio));
    border-radius: var(--radius-thumb);
    background: var(--placeholder);
  }

  /* Destino de la transición entre páginas (ver global.css) */
  .case-image--transicion {
    view-transition-class: portada;
  }

  .case-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .case-image {
      aspect-ratio: var(--ratio);
    }
  }
</style>
