---
/**
 * Fila de métricas. Desktop: columnas iguales con 48 px entre sí.
 * Mobile: apiladas (24 px), salvo `filaEnMobile` (las flechas de
 * "Métricas a mover" siguen en 3 columnas con 12 px).
 */
interface Props {
  filaEnMobile?: boolean;
}

const { filaEnMobile = false } = Astro.props;
---

<div class:list={['metricas', { 'metricas--fila': filaEnMobile }]}>
  <slot />
</div>

<style>
  .metricas {
    display: grid;
    gap: var(--space-24);
  }

  .metricas--fila {
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-12);
  }

  @media (min-width: 768px) {
    .metricas {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--space-48);
    }
  }
</style>
