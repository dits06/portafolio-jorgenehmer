---
/**
 * Punto con título (H4) y texto en --muted-2 — "Por qué importa" (10:53).
 */
interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<div class="punto">
  <h4 class="punto__titulo">{titulo}</h4>
  <p class="punto__texto"><slot /></p>
</div>

<style>
  .punto {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .punto__titulo {
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-h4);
  }

  .punto__texto {
    color: var(--muted-2);
  }
</style>
