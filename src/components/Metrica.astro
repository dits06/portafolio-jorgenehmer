---
/**
 * Métrica — Figma: componente 8:47 (Display + Body/Default en --muted-2).
 * Sin contadores animados (documento de traspaso → Animaciones).
 */
interface Props {
  valor: string;
  descripcion: string;
}

const { valor, descripcion } = Astro.props;
---

<div class="metrica">
  <p class="metrica__valor">{valor}</p>
  <p class="metrica__descripcion">{descripcion}</p>
</div>

<style>
  .metrica {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .metrica__valor {
    font-size: var(--text-metric);
    line-height: var(--leading-metric);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-metric);
    white-space: nowrap;
  }

  .metrica__descripcion {
    color: var(--muted-2);
  }
</style>
