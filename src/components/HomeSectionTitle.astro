---
/**
 * Título de sección del home con línea a la derecha.
 * Figma: Proyectos 3:69 / 103:338, Exploraciones 155:479 / 155:544.
 * Heading/H3: 20/26 → 24/31, SemiBold.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="home-title" data-reveal>
  <h2 id={id}><slot /></h2>
  <span class="home-title__rule" aria-hidden="true"></span>
</div>

<style>
  .home-title {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    padding: var(--home-title-pt) var(--page-gutter) var(--home-title-pb);
  }

  h2 {
    font-size: var(--text-sub);
    line-height: var(--leading-sub);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-sub);
    white-space: nowrap;
  }

  .home-title__rule {
    flex: 1 0 0;
    min-width: 1px;
    height: 1px;
    background: var(--rule);
  }
</style>
