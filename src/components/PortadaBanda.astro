---
/**
 * Portada en banda de los casos — Figma, página Portadas (un frame desktop de 1440 × 640
 * y uno mobile de 375 × 380 por caso). Tres capas:
 * 1. Fondo: CSS del MDX (color o degradado del frame y brillos radiales).
 * 2. Líneas decorativas: SVG a tamaño real, centrado respecto del frame y anclado abajo;
 *    no escala con el ancho de la pantalla y solo lo recorta la banda.
 * 3. Contenido: PNG ×2 transparente, centrado y anclado abajo. Su caja (el contenido sin
 *    sombras) mide como máximo 1040 px y deja 136 px libres arriba; nunca crece.
 * Bajo 768 px se usa la versión mobile; ahí el contenido escala con el ancho, como el frame de 375.
 */
import { getImage } from 'astro:assets';

type Version = {
  fondo: string;
  contenido: ImageMetadata;
  caja: [number, number];
  lineas?: { svg: ImageMetadata; x: number; y: number };
};

interface Props {
  desktop: Version;
  mobile: Version;
  alt: string;
  /** Mismo valor que el transition:name de la card del home. */
  transitionName?: string;
}

const { desktop, mobile, alt, transitionName } = Astro.props;

/** Medidas de los frames en Figma. */
const FRAME = { desktop: [1440, 640], mobile: [375, 380] } as const;

const candidateWidths = [375, 640, 750, 1080, 1113, 1500, 2227];
const srcset = async (src: ImageMetadata, format: 'avif' | 'webp') => {
  const widths = candidateWidths.filter((w) => w < src.width).concat(src.width);
  return (await getImage({ src, format, widths })).srcSet.attribute;
};

/* Ancho en px CSS del PNG (exportado en ×2). */
const anchoCss = (v: Version) => v.contenido.width / 2;

const sources = await Promise.all(
  (['avif', 'webp'] as const).flatMap((format) => [
    srcset(mobile.contenido, format).then((s) => ({
      media: '(max-width: 767px)',
      type: `image/${format}`,
      srcset: s,
      sizes: `${((anchoCss(mobile) / FRAME.mobile[0]) * 100).toFixed(2)}vw`,
    })),
    srcset(desktop.contenido, format).then((s) => ({
      media: undefined,
      type: `image/${format}`,
      srcset: s,
      sizes: `${Math.round(anchoCss(desktop))}px`,
    })),
  ]),
);
const fallback = await getImage({ src: desktop.contenido, format: 'webp', width: desktop.contenido.width });

/* Variables por versión: la hoja elige las de mobile o desktop con la media query. */
const vars = (v: Version, k: 'm' | 'd') => {
  const [fw, fh] = FRAME[k === 'm' ? 'mobile' : 'desktop'];
  const out: Record<string, string | number> = {
    [`--fondo-${k}`]: v.fondo,
    [`--caja-w-${k}`]: v.caja[0],
    [`--caja-h-${k}`]: v.caja[1],
    /* Ancho del PNG respecto de la caja (las sombras sobresalen a los lados y arriba). */
    [`--img-${k}`]: (anchoCss(v) / v.caja[0]).toFixed(4),
  };
  if (v.lineas) {
    /* Desplazamiento desde el centro del frame y desde su borde inferior. */
    out[`--lineas-x-${k}`] = `${v.lineas.x - fw / 2}px`;
    out[`--lineas-y-${k}`] = `${fh - v.lineas.y}px`;
    out[`--lineas-w-${k}`] = `${v.lineas.svg.width}px`;
  }
  return out;
};

const style = {
  ...vars(mobile, 'm'),
  ...vars(desktop, 'd'),
  ...(transitionName ? { 'view-transition-name': transitionName } : {}),
};
---

<div class:list={['portada', { 'portada--transicion': transitionName }]} style={style}>
  {
    mobile.lineas && (
      <img class="portada__lineas portada__lineas--m" src={mobile.lineas.svg.src} width={mobile.lineas.svg.width} height={mobile.lineas.svg.height} alt="" aria-hidden="true" decoding="async" />
    )
  }
  {
    desktop.lineas && (
      <img class="portada__lineas portada__lineas--d" src={desktop.lineas.svg.src} width={desktop.lineas.svg.width} height={desktop.lineas.svg.height} alt="" aria-hidden="true" decoding="async" />
    )
  }
  <div class="portada__caja">
    <picture>
      {sources.map((s) => <source media={s.media} type={s.type} srcset={s.srcset} sizes={s.sizes} />)}
      <img
        class="portada__contenido"
        src={fallback.src}
        width={desktop.contenido.width / 2}
        height={desktop.contenido.height / 2}
        alt={alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
</div>

<style>
  .portada {
    /* Versión mobile por defecto */
    --fondo: var(--fondo-m);
    --frame-w: 375;
    --caja-w: var(--caja-w-m);
    --caja-h: var(--caja-h-m);
    --img: var(--img-m);

    position: relative;
    height: var(--portada-alto);
    overflow: hidden;
    background: var(--fondo);
  }

  /* Destino de la transición entre páginas (ver global.css) */
  .portada--transicion {
    view-transition-class: portada;
  }

  .portada__lineas {
    position: absolute;
    max-width: none;
    height: auto;
    pointer-events: none;
  }

  .portada__lineas--m {
    left: calc(50% + var(--lineas-x-m));
    top: calc(100% - var(--lineas-y-m));
    width: var(--lineas-w-m);
  }

  .portada__lineas--d {
    display: none;
  }

  /* Caja del contenido: centrada, anclada abajo, con la proporción de Figma.
     En mobile ocupa lo mismo que en el frame de 375 y escala con el ancho. */
  .portada__caja {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(
      calc(var(--caja-w) / var(--frame-w) * 100%),
      calc((var(--portada-alto) - var(--portada-aire)) * var(--caja-w) / var(--caja-h))
    );
    aspect-ratio: var(--caja-w) / var(--caja-h);
    translate: -50% 0;
  }

  .portada__contenido {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: calc(var(--img) * 100%);
    max-width: none;
    height: auto;
    translate: -50% 0;
  }

  @media (min-width: 768px) {
    .portada {
      --fondo: var(--fondo-d);
      --caja-w: var(--caja-w-d);
      --caja-h: var(--caja-h-d);
      --img: var(--img-d);
    }

    .portada__lineas--m {
      display: none;
    }

    .portada__lineas--d {
      display: block;
      left: calc(50% + var(--lineas-x-d));
      top: calc(100% - var(--lineas-y-d));
      width: var(--lineas-w-d);
    }

    /* Desktop: tamaño real como máximo (1040 px), sin pasarse del margen lateral
       ni de los 136 px libres arriba. */
    .portada__caja {
      width: min(
        calc(var(--caja-w) * 1px),
        var(--portada-contenido-max),
        100% - 2 * var(--page-padding),
        calc((var(--portada-alto) - var(--portada-aire)) * var(--caja-w) / var(--caja-h))
      );
    }
  }
</style>
