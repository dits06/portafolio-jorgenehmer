---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para compartir (Open Graph / Twitter): portada del caso o card de la exploración. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Páginas que no deben indexarse (404). */
  noindex?: boolean;
}

const { title, description, image, imageAlt, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// JPEG de 1200 px de ancho: el formato que leen todas las redes al compartir.
const share = image ? await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 }) : undefined;
const shareUrl = share ? new URL(share.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    {
      share && (
        <>
          <meta property="og:image" content={shareUrl} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(share.attributes.width)} />
          <meta property="og:image:height" content={String(share.attributes.height)} />
          {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        </>
      )
    }
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {share && <meta name="twitter:image" content={shareUrl} />}
    {share && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-tiktok-sans" preload />
    <script is:inline>
      /* Aparición al hacer scroll (documento de traspaso → Animaciones): una sola vez por
         elemento; los hijos de un [data-reveal-group] que entran juntos van con 60 ms entre sí.
         Va en el head para ocultar antes del primer pintado; el CSS está en global.css. */
      (() => {
        if (!('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('js-reveal');

        const init = () => {
          const targets = [...document.querySelectorAll('[data-reveal]')].filter(
            (el) => !el.parentElement?.closest('[data-reveal-group]'),
          );
          document.querySelectorAll('[data-reveal-group]').forEach((g) => targets.push(...g.children));

          const io = new IntersectionObserver(
            (entries) => {
              const order = new Map();
              for (const e of entries) {
                const el = e.target;
                // Lo que quedó arriba de la ventana (scroll restaurado, ancla) se muestra sin animar.
                const above = e.boundingClientRect.bottom < 0;
                if (!e.isIntersecting && !above) continue;
                if (above) el.style.transition = 'none';
                const group = el.parentElement?.hasAttribute('data-reveal-group') ? el.parentElement : el;
                const n = order.get(group) ?? 0;
                order.set(group, n + 1);
                el.style.setProperty('--reveal-order', String(n));
                el.classList.add('is-revealed');
                io.unobserve(el);
              }
            },
            { rootMargin: '0px 0px -8% 0px' },
          );
          targets.forEach((el) => io.observe(el));
        };

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteNav />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
