---
/**
 * 404 — No hay frame en Figma ni texto en el documento de traspaso.
 * Usa la estructura del encabezado de Exploración (eyebrow, título, descripción) y
 * un link al inicio. Los textos quedan como [Confirmar] hasta que estén en Figma.
 * Vercel sirve dist/404.html para cualquier ruta que no existe.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="[Confirmar]" noindex>
  <section class="bloque" aria-labelledby="error-titulo">
    <div class="contenedor">
      <p class="eyebrow">404</p>
      <h1 class="titulo" id="error-titulo">[Confirmar]</h1>
      <p class="descripcion">[Confirmar]</p>
      <a class="inicio" href="/">[Confirmar]</a>
    </div>
  </section>
</BaseLayout>

<style>
  .bloque {
    padding: var(--exp-intro-pt) var(--page-gutter) var(--exp-gallery-pb);
  }

  .contenedor {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--exp-intro-gap);
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .titulo {
    font-size: var(--text-case);
    line-height: var(--leading-case);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-case);
  }

  .descripcion {
    max-width: var(--exp-description-max);
    color: var(--ink-3);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
  }

  .inicio {
    padding-top: var(--space-12);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    font-weight: var(--weight-medium);
  }
</style>
