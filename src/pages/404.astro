---
/**
 * 404 — No hay frame en Figma. Usa la estructura del encabezado de Exploración
 * (eyebrow, título, descripción) y un link al inicio. Textos aprobados por Jorge
 * en la etapa 7. Vercel sirve dist/404.html para cualquier ruta que no existe.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="bloque" aria-labelledby="error-titulo">
    <div class="contenedor">
      <p class="eyebrow">Error 404</p>
      <h1 class="titulo" id="error-titulo">Esta página no existe</h1>
      <p class="descripcion">
        Puede que el link esté mal escrito o que la página haya cambiado de lugar.
      </p>
      <a class="inicio" href="/">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .bloque {
    padding: var(--exp-intro-pt) var(--page-gutter) var(--exp-gallery-pb);
  }

  .contenedor {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--exp-intro-gap);
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .titulo {
    font-size: var(--text-case);
    line-height: var(--leading-case);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-case);
  }

  .descripcion {
    max-width: var(--exp-description-max);
    color: var(--ink-3);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
  }

  .inicio {
    padding-top: var(--space-12);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    font-weight: var(--weight-medium);
  }
</style>
